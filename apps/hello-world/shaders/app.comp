#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "abi.glsl"
#include "hb.glsl"
#define OZUI_INPUT
#include "ozui.glsl"
void main(){
 uint pressed=hbPressed();
 OzuiContext ui;
 vec2 pointer=hbTouchCount()>0u?hbTouch(0u):vec2(-1.0);
 uint pointerDown=hbTouchCount()>0u?1u:0u;
 ozuiBegin(ui,c.game.x,c.game.y,pressed,pointer, pointerDown);
 OzuiColumn buttons;
 ozuiColumnBegin(buttons,vec2(300.0,385.0),680.0,0.0,16.0);
 vec4 startRect=ozuiColumnNext(buttons,72.0);
 vec4 backRect=ozuiColumnNext(buttons,72.0);
 bool started=ozuiButton(ui,1u,startRect);
 bool back=ozuiButton(ui,2u,backRect);
 ozuiEnd(ui,c.game.x,c.game.y);
 c.game.w=ui.errors;
 if(started)c.game.z++;
 if(back&&hbConnected())hbExit();
 c.motion.x+=1.0/60.0;c.state.z++;
 c.transition.x=max(0.0,c.transition.x-1.0/15.0);
 if(hbConnected() && (pressed&(HB_B|HB_MINUS))!=0u)hbExit();
 hbEndFrame();
}
